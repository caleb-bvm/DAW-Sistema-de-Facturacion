# Copiar a .env para desarrollo. Para publicar, ver .env.production.example.
APP_ENV=development
APP_ORIGIN=https://ourpxi.dev
HOST=127.0.0.1
PORT=3000
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=localhost
DB_PORT=1433
# Autenticación SQL: DB_AUTH=sql, DB_USER y DB_PASS. Puerto TCP fijo recomendado.
DB_INSTANCE=SQLEXPRESS
DB_ENCRYPT=true
# Sólo desarrollo con certificado autofirmado. En producción usar certificado válido y false.
DB_TRUST_CERTIFICATE=true
DB_NAME=facturacion_db
DB_USER=facturacion_app
DB_PASS=
COUNTRY=SV
TIMEZONE=America/El_Salvador
# IP pública o CIDR reales separados por coma. Sólo proxies bajo tu control.
OFFICE_NETWORKS=
TRUSTED_PROXIES=
GEOIP_DATABASE=
SESSION_MINUTES=30
SMTP_HOST=mail.ourpxi.dev
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
# PLAIN o LOGIN se negocia automáticamente según lo anunciado por el servidor.
# TLS implícito verificado en mail.ourpxi.dev:465.
# TLS implícito: SMTP_SECURE=true y SMTP_REQUIRE_TLS=false.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
COMPANY_NAME=Empresa de demostración
COMPANY_NIT=
COMPANY_NRC=
COMPANY_ACTIVITY=
COMPANY_ADDRESS=El Salvador
COMPANY_PHONE=
COMPANY_EMAIL=
# Sólo para inicializar admin desde consola. Cambiar por una clave propia de 12 caracteres o más.
BOOTSTRAP_ADMIN_PASSWORD=

APP_BASE_PATH=/facturacion

# ── Docker (docker-compose.yml) ──
# El contenedor de la app fuerza DB_AUTH=sql y DB_HOST=db; DB_AUTH=windows
# (msnodesqlv8/ODBC) no está disponible en Linux. SMTP, COMPANY_* y las demás
# variables de arriba se reutilizan tal cual dentro del contenedor.
# Contraseña del sa del contenedor SQL Server. Obligatoria para arrancar
# compose: 8+ caracteres con mayúsculas, minúsculas y números. No es DB_PASS.
# Con ella el contenedor crea el login DB_USER (una sola vez) en el primer arranque.
#MSSQL_SA_PASSWORD=
# DB_PASS (arriba) también es obligatoria con Docker: será la contraseña del
# login de la aplicación que el contenedor crea en el primer arranque.
# OFFICE_NETWORKS vacío equivale, en compose, a la red interna 172.31.31.0/24:
# define aquí tus reales (y la red del contenedor) para sobreescribirlo.
# Puerto del host para la app en el perfil dev (por defecto 3000).
#APP_PORT=3000
# Puerto del host para el proxy TLS de docker-compose.prod.yml (por defecto 8443).
#HTTPS_PORT=8443
# Nombre común (CN) del certificado autofirmado que genera tls-init:
# un nombre DNS o una IP, p. ej. la dirección del servidor en la red local.
#TLS_CN=localhost
