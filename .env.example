# Copiar a .env para desarrollo. Para publicar, ver .env.production.example.
APP_ENV=development
APP_ORIGIN=https://ourpxi.dev
HOST=127.0.0.1
PORT=3000
DB_AUTH=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=localhost
DB_PORT=1433
# Autenticación SQL: DB_AUTH=sql, DB_USER y DB_PASS. Puerto TCP fijo recomendado.
DB_INSTANCE=SQLEXPRESS
DB_ENCRYPT=true
# Sólo desarrollo con certificado autofirmado. En producción usar certificado válido y false.
DB_TRUST_CERTIFICATE=true
DB_NAME=facturacion_db
DB_USER=facturacion_app
DB_PASS=
COUNTRY=SV
TIMEZONE=America/El_Salvador
# IP pública o CIDR reales separados por coma. Sólo proxies bajo tu control.
OFFICE_NETWORKS=
TRUSTED_PROXIES=
GEOIP_DATABASE=
SESSION_MINUTES=30
SMTP_HOST=mail.ourpxi.dev
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
# PLAIN o LOGIN se negocia automáticamente según lo anunciado por el servidor.
# TLS implícito verificado en mail.ourpxi.dev:465.
# TLS implícito: SMTP_SECURE=true y SMTP_REQUIRE_TLS=false.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
COMPANY_NAME=Empresa de demostración
COMPANY_NIT=
COMPANY_NRC=
COMPANY_ACTIVITY=
COMPANY_ADDRESS=El Salvador
COMPANY_PHONE=
COMPANY_EMAIL=
# Sólo para inicializar admin desde consola. Cambiar por una clave propia de 12 caracteres o más.
BOOTSTRAP_ADMIN_PASSWORD=

APP_BASE_PATH=/facturacion
