{
  "name": "sistema-facturacion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "db:install": "node --env-file-if-exists=.env scripts/install.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "mail": "node --env-file-if-exists=.env scripts/mail-worker.js",
    "test:integration": "node --env-file=.env --env-file=.env.test --test tests/sqlserver.integration.test.js"
  },
  "dependencies": {
    "maxmind": "^5.0.7",
    "msnodesqlv8": "^5.5.0",
    "mssql": "^12.7.4",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.20.2"
  }
}
