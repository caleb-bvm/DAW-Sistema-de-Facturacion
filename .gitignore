# Dependencias y caché del gestor de paquetes
node_modules/
.pnpm-store/

# Configuración privada (conservar las plantillas de ejemplo)
.env
.env.*
!.env.example
!.env.*.example

# Resultados de pruebas y cobertura
/test-output/
/coverage/
/.nyc_output/

# Archivos generados y registros
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Respaldos locales de versiones anteriores (no forman parte de la aplicación)
/storage/
/deploy/geoip/*
!/deploy/geoip/.gitkeep

# Archivos locales de Codex y del sistema operativo
/.codex-remote-attachments/
.DS_Store
Thumbs.db
Desktop.ini
