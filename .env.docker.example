# Copy to .env.docker. Use --env-file .env.docker for every Compose command.
APP_DOMAIN=facturacion.example.com
ACME_EMAIL=admin@example.com
APP_ORIGIN=https://facturacion.example.com
APP_BASE_PATH=/facturacion

# External SQL Server with SQL authentication and a fixed TCP port.
# localhost would refer to the app container, not the server running Docker.
DB_HOST=sql.example.com
DB_PORT=1433
DB_NAME=facturacion_db
DB_USER=facturacion_app
DB_PASS='REEMPLAZAR_CON_PASSWORD_SQL'
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=false

COUNTRY=SV
TIMEZONE=America/El_Salvador
# Required for first login: public IP/CIDR of your office, not the Docker network.
OFFICE_NETWORKS=
SESSION_MINUTES=30
# Optional: place the database in deploy/geoip and uncomment this path.
# GEOIP_DATABASE=/app/geoip/GeoLite2-Country.mmdb
GEOIP_DATABASE=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
SMTP_USER=mail@example.com
SMTP_PASSWORD='REEMPLAZAR_CON_PASSWORD_SMTP'
MAIL_FROM=mail@example.com
ADMIN_EMAIL=admin@example.com

COMPANY_NAME=Zona Digital
COMPANY_NIT=0614-150326-101-3
COMPANY_NRC=345678-9
COMPANY_ACTIVITY=Venta de equipos informáticos, accesorios y servicios de soporte técnico
COMPANY_ADDRESS=Avenida Innovación, edificio Pixel, local 12, San Salvador, El Salvador
COMPANY_PHONE=+503 2000-0123
COMPANY_EMAIL=contacto@zonadigital.example

# Adjust together if this subnet overlaps your server/VPN networks.
# Keep the proxy IP outside the dynamic range, but inside the subnet.
DOCKER_SUBNET=172.30.80.0/24
DOCKER_DYNAMIC_RANGE=172.30.80.128/25
DOCKER_PROXY_IP=172.30.80.2
IMAGE_TAG=local
